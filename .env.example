# Turso (local dev can use file:local.db)
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:5174

# Clerk (Task 8)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_UMAMI_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Vercel Blob (uploads; from the connected Blob store)
BLOB_READ_WRITE_TOKEN=

# Cloudflare Turnstile (spam check on public forms; leave empty locally)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Sites a solved token may come from, comma-separated (production only; empty skips the check)
TURNSTILE_HOSTNAMES=

# Resend (email receipts; optional)
RESEND_API_KEY=
EMAIL_FROM=JCI Roxas Halaran <hello@jciroxashalaran.com>
